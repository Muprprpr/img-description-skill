{
  "name": "img_hamming_skill",
  "version": "1.0.0",
  "description": "图片聚类与描述中间组件 - 基于dHash进行图片分级聚类，生成拼图并提供AI描述",
  "author": "ASUS",
  "entry_point": "main.py",
  "type": "intermediate",
  "runtime": "python",
  "python_version": ">=3.9",
  "capabilities": [
    "image_clustering",
    "image_collage_generation",
    "multi_modal_description"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "image_dir": {
        "type": "string",
        "description": "图片文件夹路径"
      },
      "output_dir": {
        "type": "string",
        "description": "输出目录路径（可选，默认为./collages）",
        "default": "./collages"
      },
      "description_prompt": {
        "type": "string",
        "description": "AI描述提示词（可选，默认为通用描述）",
        "default": "请详细描述这些图片的内容"
      }
    },
    "required": ["image_dir"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "total_images": {
        "type": "integer",
        "description": "处理的图片总数"
      },
      "groups": {
        "type": "array",
        "description": "聚类分组",
        "items": {
          "type": "object",
          "properties": {
            "group_id": {"type": "integer"},
            "collage_path": {"type": "string"},
            "collage_description": {"type": "string"},
            "total_images": {"type": "integer"},
            "high_sim_subgroups": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sub_leader_path": {"type": "string"},
                  "total_images": {"type": "integer"},
                  "exact_variants": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "count": {"type": "integer"},
                        "images": {"type": "array", "items": {"type": "string"}}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "dependencies": {
    "executable": "hamming.exe",
    "python_packages": [
      "anthropic",
      "pillow",
      "pydantic"
    ]
  },
  "environment": {
    "anthropic_api_key": {
      "description": "Anthropic API密钥，用于多模态描述",
      "required": true
    }
  }
}

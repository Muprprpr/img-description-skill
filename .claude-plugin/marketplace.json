  },
  "config": {
    "requires_api_key": true,
    "api_key_name": "ANTHROPIC_API_KEY",
    "api_provider": "anthropic"
  },
  "categories": ["image-processing", "computer-vision", "clustering"],
  "tags": [
    "image-clustering",
    "dhash",

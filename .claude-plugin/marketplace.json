  "repository": {
    "type": "git",
    "url": "https://github.com/Muprprpr/img-description-skill.git"
  },
  "homepage": "https://github.com/Muprprpr/img-description-skill#readme",
  "bugs": {
    "url": "https://github.com/Muprprpr/img-description-skill/issues"
  },
  "skills": [
    {
      "name": "img-hamming-skill",
      "path": "skills/img-hamming-skill",
      "description": "图片聚类与描述中间组件 - 基于dHash进行图片分级聚类，生成拼图并提供AI描述"
    }
  ],
  "runtime": {
    "python": ">=3.9",
    "dependencies": [
      "anthropic>=0.40.0",
      "pillow>=11.0.0"
